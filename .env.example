# Local XAMPP MySQL settings (default XAMPP install: user root, no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eco_coal

# Staff passcode for the /admin page. Change this to your own.
ADMIN_KEY=ecocoal-staff

# Business WhatsApp number in international format, digits only (no + or spaces).
# Example: 256772123456
NEXT_PUBLIC_WHATSAPP_NUMBER=256700000000
